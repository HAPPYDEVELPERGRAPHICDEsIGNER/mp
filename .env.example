# ==============================================================================
# AI Software Engineering Copilot — Gemini Edition
# Environment Configuration
# ==============================================================================
# Add your Google Gemini API key below (get one at https://aistudio.google.com/)
# Copy this file to .env:
# PowerShell: Copy-Item .env.example .env
# Bash:       cp .env.example .env
# ==============================================================================

GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Optional: GitHub Personal Access Token (for higher GitHub Assistant rate limits)
GITHUB_TOKEN=

# Optional: Local Database Path (defaults to database/copilot.db)
COPILOT_DB=database/copilot.db

# Optional: Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
