# ==============================================================================
# AI Software Engineering Copilot — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root to configure local settings:
# PowerShell: Copy-Item .env.example .env
# Bash:       cp .env.example .env
# ==============================================================================

# Optional: Google Gemini API configuration
# If not configured, the copilot runs in offline Demo Mode with deterministic synthesizers.
# Get a key at: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API configuration (Alternative to Gemini)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: GitHub Personal Access Token (for higher rate limits on GitHub Assistant)
# Unauthenticated requests are limited to 60 requests/hr. A personal access token increases this to 5,000/hr.
# GITHUB_TOKEN=your_github_personal_access_token_here

# Optional: Database Path (Defaults to database/copilot.db)
# COPILOT_DB=database/copilot.db

# Optional: Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
